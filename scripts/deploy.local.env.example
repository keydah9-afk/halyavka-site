# Скопируй этот файл в scripts/deploy.local.env и впиши свои данные.
# deploy.local.env в git НЕ попадает (см. .gitignore).

# Логин и хост SSH, как в команде `ssh логин@хост`
SSH_TARGET=логин@halyavka.net

# Порт SSH (у Hetzner Webhosting часто 22, иногда 222)
SSH_PORT=22

# Абсолютный путь к корню сайта на сервере — туда, куда ты сейчас
# распаковываешь архив с dist. Без слэша на конце.
# Узнать: зайти по ssh и выполнить `pwd` в нужной папке.
WEBROOT=/usr/www/users/ЛОГИН
