// Worker сайта halyavka.net (переезд с Hetzner MC60: ~/Developer/semrush/ПЛАН-УХОДА-С-MC60.md, здесь — ЗАПУСК-WORKERS.md).
// Картинки — wrangler.images.jsonc, www → без www — wrangler.www.jsonc.
// ВНИМАНИЕ: "routes" сюда не вписывать (как у shkilni и matematika): маршрут halyavka.net/* ставит scripts/workers.sh route
// в день запуска; `wrangler deploy` без routes маршрут не трогает — выкладка до запуска сайт не переключает,
// а откат — снять маршрут, и снова отвечает Apache на MC60.
// workers_dev: true — только на время проверки (halyavka.ztrmnn.workers.dev); в день запуска — false.
// account_id — аккаунт сайтов ГДЗ Ztrmnn@… (Workers Paid с 01.11.2026).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halyavka",
  "account_id": "016884b36b0f6f68649f04bf2d661fc8",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /5-klas/ → dist/5-klas/index.html (trailingSlash: 'always' в astro.config.ts)
    "html_handling": "auto-trailing-slash",
    // адреса без файла получает код: 404 со страницей
    "not_found_handling": "none",
    // Код первым — только для адресов без слеша на конце: там статика ответила бы 307, а нужен 301.
    // Страницы (со слешем) и /_astro/* идут мимо кода.
    "run_worker_first": ["/*", "!/*/", "!/_astro/*"]
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
