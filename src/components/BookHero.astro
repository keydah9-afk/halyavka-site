---
/*
  BookHero — обкладинка + компактні дані про підручник в одній рамці.
  Мобільний-перший: факти стоять праворуч від обкладинки, дрібним шрифтом,
  щоб задіяти кожен шматок місця всередині червоної рамки.
*/
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  author: string;
  year: number | string;
  typegdz: string;
  img: ImageMetadata;
  alt?: string;
  description?: string;
  publisher?: string;
  city?: string;
  program?: string;
  count?: number;
  updatedAt?: string;
  grif?: string;
}

const { title, author, year, typegdz, img, alt, description, publisher, city, program, count, updatedAt, grif } =
  Astro.props;

const fmt = (iso?: string) => {
  if (!iso) return undefined;
  const [y, m, d] = iso.split('-');
  return d && m && y ? `${d}.${m}.${y}` : iso;
};
const updated = fmt(updatedAt);
---

<div class="bh">
  <h1 class="bh__title">{title}</h1>
  <div class="bh__body">
    <div class="bh__img">
      <Image src={img} alt={alt || title} width={220} height={314} class="bh__cover" />
    </div>
    <dl class="bh__facts">
      <div><dt>Автор</dt><dd>{author}</dd></div>
      {publisher && <div><dt>Видавництво</dt><dd>«{publisher}»{city ? `, ${city}` : ''}</dd></div>}
      <div><dt>Рік</dt><dd>{year}</dd></div>
      {program && <div><dt>Програма</dt><dd>{program}</dd></div>}
      <div><dt>Тип</dt><dd>{typegdz}</dd></div>
      {count && <div><dt>Вправ</dt><dd>{count}</dd></div>}
      {updated && <div><dt>Оновлено</dt><dd>{updated}</dd></div>}
    </dl>
  </div>
  {description && <p class="bh__desc">{description}</p>}
  {grif && <p class="bh__grif">{grif}</p>}
</div>

<style>
  .bh {
    max-width: 1000px;
    width: 92%;
    margin: 1.25rem auto 0;
    background: #fdf0d5;
    border: 4px solid #c1121f;
    border-radius: 1rem;
    padding: 0.9rem 1rem;
    text-align: left;
  }
  .bh__title {
    font-size: 1.35rem;
    font-weight: bold;
    color: #c1121f;
    line-height: 1.2;
    margin: 0 0 0.7rem;
  }
  .bh__body { display: flex; gap: 0.9rem; align-items: flex-start; }
  .bh__img { flex: none; }
  .bh__cover {
    width: 130px;
    height: auto;
    border-radius: 0.4rem;
    box-shadow: 0 2px 8px rgba(0, 48, 73, 0.18);
    display: block;
  }
  .bh__facts {
    flex: 1;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  .bh__facts > div { display: flex; gap: 0.45rem; align-items: baseline; font-size: 0.85rem; line-height: 1.25; }
  .bh__facts dt { flex: none; color: #6c757d; min-width: 90px; }
  .bh__facts dd { margin: 0; color: #003049; font-weight: 600; }
  .bh__desc { margin: 0.8rem 0 0; font-size: 0.9rem; color: #46424b; line-height: 1.45; }
  .bh__grif { margin: 0.5rem 0 0; font-size: 0.78rem; color: #6c757d; font-style: italic; }

  @media (max-width: 600px) {
    .bh { width: 98%; padding: 0.7rem; border-width: 3px; }
    .bh__title { font-size: 1.05rem; margin-bottom: 0.5rem; }
    .bh__cover { width: 108px; }
    .bh__body { gap: 0.6rem; }
    .bh__facts > div { font-size: 0.8rem; gap: 0.35rem; }
    .bh__facts dt { min-width: 74px; }
    .bh__desc { font-size: 0.82rem; margin-top: 0.6rem; }
  }

  :global(.dark) .bh { background: #003049; border-color: #c1121f; }
  :global(.dark) .bh__title { color: #fdf0d5; }
  :global(.dark) .bh__facts dt { color: #9fb3c0; }
  :global(.dark) .bh__facts dd { color: #fdf0d5; }
  :global(.dark) .bh__desc { color: #e6e6e6; }
  :global(.dark) .bh__grif { color: #9fb3c0; }
</style>
