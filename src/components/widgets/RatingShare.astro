---
import { Icon } from 'astro-icon/components';

export interface Props {
  classTitle?: string;
  url?: string;
}

const { classTitle = "ГДЗ", url = Astro.url.href } = Astro.props;
---

<div class="rating-share-widget flex flex-wrap items-center justify-between gap-4 rounded-xl bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-gray-700 p-4 mb-6 shadow-sm">
  
  <div class="flex items-center gap-4">
    <div class="flex items-center gap-2">
       <span class="text-sm font-semibold text-gray-500 dark:text-gray-400">Корисно?</span>
       
       <button id="btn-like" class="group flex items-center gap-1 rounded-full bg-white dark:bg-slate-700 px-3 py-1.5 text-sm font-bold text-gray-700 dark:text-gray-200 shadow-sm transition hover:bg-green-50 hover:text-green-600 border border-gray-200 dark:border-gray-600">
         <Icon name="tabler:thumb-up" class="w-5 h-5 group-hover:scale-110 transition-transform" />
         <span id="like-count">...</span>
       </button>

       <button id="btn-dislike" class="group flex items-center gap-1 rounded-full bg-white dark:bg-slate-700 px-3 py-1.5 text-sm font-bold text-gray-700 dark:text-gray-200 shadow-sm transition hover:bg-red-50 hover:text-red-600 border border-gray-200 dark:border-gray-600">
         <Icon name="tabler:thumb-down" class="w-5 h-5 group-hover:scale-110 transition-transform mt-1" />
         <span id="dislike-count"></span>
       </button>
    </div>

    <div class="h-6 w-px bg-gray-300 dark:bg-gray-600 hidden sm:block"></div>

    <div class="flex items-center gap-1 text-yellow-500 font-bold">
    <Icon name="tabler:star-filled" class="w-5 h-5" />
    <span id="rating-text">—</span>
    </div>
  </div>

  <div class="flex items-center gap-2 relative">

<button 
  id="error-report-btn" 
  class="flex items-center gap-1.5 rounded-lg bg-white dark:bg-slate-700 border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-300 px-3 py-2 text-sm font-medium hover:bg-amber-50 hover:border-amber-300 hover:text-amber-700 dark:hover:bg-amber-900/20 transition-colors"
  title="Повідомити про помилку"
>
  <Icon name="tabler:bug" class="w-5 h-5" />
  <span>Помилка</span>
</button>

    <button id="share-btn" class="flex items-center gap-2 rounded-lg bg-[#003049] text-white px-4 py-2 text-sm font-semibold hover:bg-[#c1121f] transition-colors shadow-md">
      <Icon name="tabler:share" class="w-5 h-5" />
      <span>Поділитися</span>
    </button>
    <div id="share-dropdown" class="absolute right-0 top-full mt-2 w-56 hidden z-50 origin-top-right rounded-lg bg-white dark:bg-slate-800 shadow-xl border border-gray-100 dark:border-gray-700">
       <div class="p-1">
 
        <a 
          href={`https://www.facebook.com/sharer/sharer.php?u=${url}`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="flex items-center gap-3 w-full px-3 py-2 text-sm hover:bg-blue-50 dark:hover:bg-slate-700 rounded-md transition"
        >
          <Icon name="tabler:brand-facebook" class="w-5 h-5 text-blue-600" /> 
          Facebook
        </a>

        <a 
          href={`viber://forward?text=${url}`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="flex items-center gap-3 w-full px-3 py-2 text-sm hover:bg-purple-50 dark:hover:bg-slate-700 rounded-md transition"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-purple-500" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M2 10l1 1h2l.5 3.5l2.5 -2.5h6l1 -1v-6l-1 -1h-11l-1 1z" />
            <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
            <path d="M8 12a4 4 0 0 1 4 -4" />
          </svg>
          Viber
        </a>

        <a href={`https://wa.me/?text=${url}`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 w-full px-3 py-2 text-sm text-gray-700 dark:text-gray-200 rounded-md hover:bg-green-50 dark:hover:bg-slate-700 hover:text-green-500 transition">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5 text-green-500" /> WhatsApp
        </a>

        <a href={`https://t.me/share/url?url=${url}&text=${classTitle}`} target="_blank" class="flex items-center gap-3 w-full px-3 py-2 text-sm hover:bg-blue-50 dark:hover:bg-slate-700 rounded-md">
          <Icon name="tabler:brand-telegram" class="w-5 h-5 text-blue-400" /> Telegram
        </a>
        <button id="copy-link-btn" class="flex items-center gap-3 w-full px-3 py-2 text-sm hover:bg-gray-100 dark:hover:bg-slate-700 rounded-md border-t border-gray-100 dark:border-gray-700 mt-1">
          <Icon name="tabler:copy" class="w-5 h-5 text-gray-400" /> Скопіювати
        </button>
       </div>
    </div>
  </div>
</div>

<!-- МОДАЛКА "Повідомити про помилку" -->
<div id="error-modal" class="fixed inset-0 z-[9999] hidden items-center justify-center p-4" role="dialog" aria-modal="true">
  <div id="error-modal-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
  <div class="relative bg-white dark:bg-slate-800 rounded-xl shadow-2xl max-w-md w-full p-6">
    <button id="error-modal-close" class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl leading-none" aria-label="Закрити">×</button>
    
    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2 flex items-center gap-2">
      <Icon name="tabler:bug" class="w-6 h-6 text-amber-500" />
      Дякуємо, що допомагаєте!
    </h3>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
      Оберіть зручний спосіб. Посилання на сторінку та номер вправи підставляються автоматично — вам залишиться лише описати, що саме не так.
    </p>
    
    <div id="error-preview" class="bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-gray-700 rounded-lg p-3 font-mono text-xs text-gray-700 dark:text-gray-300 whitespace-pre-wrap mb-4 max-h-36 overflow-y-auto"></div>

    <div class="flex flex-col gap-2">
      <a id="error-btn-tg" href="#" target="_blank" rel="noopener" class="flex items-center justify-center gap-2 bg-[#229ED9] hover:bg-[#1a8ac0] text-white font-semibold py-2.5 px-4 rounded-lg transition-colors">
        <Icon name="tabler:brand-telegram" class="w-5 h-5" />
        Написати в Telegram
      </a>
      <a id="error-btn-email" href="#" class="flex items-center justify-center gap-2 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 text-gray-700 dark:text-gray-200 font-semibold py-2.5 px-4 rounded-lg transition-colors border border-gray-200 dark:border-gray-600">
        <Icon name="tabler:mail" class="w-5 h-5" />
        Написати на email
      </a>
    </div>

    <p class="text-xs text-gray-400 dark:text-gray-500 text-center mt-3">
      Текст повідомлення автоматично скопіюється в буфер обміну при натисканні "Telegram"
    </p>
  </div>
</div>

<script>
  import { supabase } from '~/lib/supabase';

  function getAnonId(): string {
    let id = localStorage.getItem('halyavka_anon_id');
    if (!id) {
      id = crypto.randomUUID();
      localStorage.setItem('halyavka_anon_id', id);
    }
    return id;
  }

  function getBookId(): string {
    const path = window.location.pathname;
    return path.endsWith('/') ? path : path + '/';
  }

  function formatRating(likes: number, dislikes: number): string {
    const total = likes + dislikes;
    if (total === 0) return '—';
    const score = (likes / total) * 5;
    return `${score.toFixed(1)}/5`;
  }

  async function initRating() {
    const likeBtn = document.getElementById('btn-like') as HTMLButtonElement | null;
    const dislikeBtn = document.getElementById('btn-dislike') as HTMLButtonElement | null;
    const likeCountEl = document.getElementById('like-count');
    const dislikeCountEl = document.getElementById('dislike-count');
    const ratingTextEl = document.getElementById('rating-text');

    if (!likeBtn || !dislikeBtn || !likeCountEl) return;

    const bookId = getBookId();
    const anonId = getAnonId();

    const { data: agg } = await supabase
      .from('book_rating_agg')
      .select('likes, dislikes')
      .eq('book_id', bookId)
      .maybeSingle();

    let likes = agg?.likes ?? 0;
    let dislikes = agg?.dislikes ?? 0;

    const { data: myVote } = await supabase
      .from('book_votes')
      .select('vote')
      .eq('book_id', bookId)
      .eq('anon_id', anonId)
      .maybeSingle();

    function render() {
      likeCountEl!.innerText = String(likes);
      if (dislikeCountEl) {
        dislikeCountEl.innerText = dislikes > 0 ? String(dislikes) : '';
      }
      if (ratingTextEl) {
        ratingTextEl.innerText = formatRating(likes, dislikes);
      }

      likeBtn!.classList.remove('bg-green-100', 'text-green-700', 'border-green-300');
      dislikeBtn!.classList.remove('bg-red-100', 'text-red-700', 'border-red-300');

      if (currentVote === 1) {
        likeBtn!.classList.add('bg-green-100', 'text-green-700', 'border-green-300');
      } else if (currentVote === -1) {
        dislikeBtn!.classList.add('bg-red-100', 'text-red-700', 'border-red-300');
      }
    }

    let currentVote: number | null = myVote?.vote ?? null;
    render();

    async function vote(newVote: number) {
      const prevVote = currentVote;
      if (prevVote === newVote) {
        if (newVote === 1) likes--;
        else dislikes--;
        currentVote = null;
      } else {
        if (prevVote === 1) likes--;
        if (prevVote === -1) dislikes--;
        if (newVote === 1) likes++;
        if (newVote === -1) dislikes++;
        currentVote = newVote;
      }
      render();

      const { data, error } = await supabase.rpc('cast_vote', {
        p_book_id: bookId,
        p_anon_id: anonId,
        p_vote: newVote,
      });

      if (error) {
        console.error('Vote error:', error);
        return;
      }

      if (data && data[0]) {
        likes = data[0].likes;
        dislikes = data[0].dislikes;
        render();
      }
    }

    likeBtn.onclick = () => vote(1);
    dislikeBtn.onclick = () => vote(-1);
  }

  function initShare() {
    const shareBtn = document.getElementById('share-btn');
    const dropdown = document.getElementById('share-dropdown');
    const copyBtn = document.getElementById('copy-link-btn');

    if (!shareBtn || !dropdown) return;

    dropdown.classList.add('hidden');

    shareBtn.onclick = (e) => {
      e.stopPropagation();
      dropdown.classList.toggle('hidden');
    };

    document.onclick = (e) => {
      if (!shareBtn.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
        dropdown.classList.add('hidden');
      }
    };

    if (copyBtn) {
      copyBtn.onclick = () => {
        navigator.clipboard.writeText(window.location.href);
        copyBtn.innerHTML = '<span class="text-green-600 text-xs font-bold">Скопійовано!</span>';
        setTimeout(() => copyBtn.innerHTML = 'Скопіювати', 1500);
      };
    }
  }

  // ─── Error Report ────────────────────────────────────────────────────────────

  const TG_BOT_USERNAME = 'halyavka_errors_bot';
  const SUPPORT_EMAIL = 'admin@halyavka.net';

  function buildErrorMessage(): string {
    const url = window.location.href;
    const hash = window.location.hash.replace('#', '');
    const pageTitle = document.title;

    const lines = [
      `🐞 Помилка на сайті халявка`,
      ``,
      `Сторінка: ${pageTitle}`,
      hash ? `Вправа: №${hash}` : null,
      `Посилання: ${url}`,
      ``,
      `Опис помилки: `,
    ].filter(Boolean);

    return lines.join('\n');
  }

  async function saveErrorReport(channel: 'telegram' | 'email') {
    try {
      const hash = window.location.hash.replace('#', '');
      await supabase.from('error_reports').insert({
        book_id: getBookId(),
        exercise_number: hash || null,
        page_url: window.location.href,
        page_title: document.title,
        anon_id: getAnonId(),
        channel: channel,
      });
    } catch (err) {
      console.warn('Failed to save error report:', err);
    }
  }

  function initErrorReport() {
    const btn = document.getElementById('error-report-btn');
    const modal = document.getElementById('error-modal');
    const backdrop = document.getElementById('error-modal-backdrop');
    const closeBtn = document.getElementById('error-modal-close');
    const preview = document.getElementById('error-preview');
    const btnTg = document.getElementById('error-btn-tg') as HTMLAnchorElement | null;
    const btnEmail = document.getElementById('error-btn-email') as HTMLAnchorElement | null;

    if (!btn || !modal || !preview || !btnTg || !btnEmail) return;

    function openModal() {
      const message = buildErrorMessage();
      preview!.textContent = message;

      const hash = window.location.hash.replace('#', '');
      const subject = encodeURIComponent(hash ? `Помилка: вправа ${hash}` : 'Помилка на сайті');
      const body = encodeURIComponent(message);

      btnEmail!.href = `mailto:${SUPPORT_EMAIL}?subject=${subject}&body=${body}`;
      btnEmail!.onclick = () => {
        saveErrorReport('email');
      };

      btnTg!.href = `https://t.me/${TG_BOT_USERNAME}?start=report`;
btnTg!.onclick = async () => {
  // Сначала в буфер — пока клик "свежий"
  try {
    await navigator.clipboard.writeText(message);
  } catch (err) {
    console.warn('Clipboard failed', err);
  }
  // Потом уже в Supabase (fire-and-forget, не ждём)
  saveErrorReport('telegram');
};

      modal!.classList.remove('hidden');
      modal!.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal!.classList.add('hidden');
      modal!.classList.remove('flex');
      document.body.style.overflow = '';
    }

    btn.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal!.classList.contains('hidden')) closeModal();
    });

    window.addEventListener('hashchange', () => {
      if (!modal!.classList.contains('hidden')) {
        preview!.textContent = buildErrorMessage();
      }
    });
  }

  // ─────────────────────────────────────────────────────────────────────────────

  function init() {
    initRating();
    initShare();
    initErrorReport();
  }

  document.addEventListener('astro:page-load', init);
  if (document.readyState !== 'loading') {
    init();
  }
</script>