---
import { Image } from 'astro:assets'; // Импортируем Image компонент

const { title, author, typegdz, year, img, alt, description, publisher } = Astro.props; // Добавил publisher
---
<div class="book-card" itemscope itemtype="https://schema.org/Book">
  <h1 class="book-title" itemprop="name">{title}</h1>
  <div class="book-description">
    <p itemprop="description">{description}</p>
  </div>
  <div class="book-bottom">
 <div class="book-img">
  <Image
    itemprop="thumbnailUrl"
    src={img}
    alt={alt || title}
    widths={[200, 400, 600, 800]}
    sizes="(max-width: 600px) 200px, 400px"
    fetchpriority="high"
    loading="eager"
    format="webp"
    quality={80}
  />
</div>
    </div>
    <div class="book-authors">
      <div><b>Автор:</b> <span itemprop="author" itemscope itemtype="https://schema.org/Person"><span itemprop="name">{author}</span></span></div>
      <div><b>Тип:</b> <span itemprop="genre">{typegdz}</span></div>
      <div class="book-year"><b>Рік видання:</b> <span itemprop="datePublished">{year}</span></div>
      
    </div>
  </div>
</div>

<style>
/* Ваши стили остаются без изменений */
.book-card {
  max-width: 1000px;
  width: 80%;
  margin: 2rem auto;
  background: #FDF0D5;
  border: 4px solid #C1121F;
  border-radius: 1.5rem;
  padding: 2rem 1.5rem 1.5rem 1.5rem;
  box-shadow: 0 4px 20px 0 rgba(0,0,0,0.07);
}

.book-title {
  font-size: 2.1rem;
  font-weight: bold;
  color: #C1121F;
  letter-spacing: -1px;
  line-height: 1.2;
  background: #FDF0D5;
  display: inline-block;
  margin: 0 0 0.5rem 0;
}

.book-description {
  color: #46424b;
  font-size: 1.1rem;
  margin-bottom: 1.2rem;
  line-height: 1.5;
  text-align: left;
}

.book-bottom {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 1.5rem;
  margin-top: 0.5rem;
}

.book-img {
  border-radius: 1rem;
  box-shadow: none;
  padding: 0;
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
}

.book-img img { /* Note: This style targets the <img> tag generated by <Image> */
  display: block;
  max-width: 400px;
  min-width: 400px;
  width: 100%;
  height: auto;
  border-radius: 0.5rem;
  box-shadow: 0 2px 8px 0 rgba(0,48,73,0.09);
}

.book-authors {
  color: #003049;
  font-size: 1.13rem;
  font-weight: 500;
  text-align: left;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 0.4rem;
  padding-top: 0.3rem;
}

.book-authors .book-year {
  color: #C1121F;
  font-weight: bold;
}

/* Мобильная версия */
@media (max-width: 600px) {
  .book-card {
    width: 99%;
    max-width: 99vw;
    padding: 1rem 0.3rem 1.2rem 0.3rem;
  }
  .book-title {
    font-size: 1.15rem;
    padding: 0.18em 0.5em;
  }
  .book-description {
    font-size: 0.97rem;
    margin-bottom: 0.85rem;
  }
  .book-bottom {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    gap: 0.5rem;
    margin-top: 0.2rem;
  }
  .book-img img {
    max-width: 200px;
    min-width: 200px;
  }
  .book-authors {
    align-items: flex-start;
    font-size: 1.02rem;
    padding-top: 0.18rem;
  }
}

/* Dark theme styles */
:global(.dark) .book-card {
  background: #003049;        /* Тёмно-синий — как основной фон блока */
  border-color: #C1121F;      /* Красная обводка — фирменная */
  box-shadow: 0 4px 28px 0 rgba(0,0,0,0.25);
}
:global(.dark) .book-title {
  color: #FDF0D5;             /* Светлый на тёмном — хороший контраст */
  background: #003049;
}
:global(.dark) .book-description {
  color: #FDF0D5;
}
:global(.dark) .book-authors {
  color: #FDF0D5;
}
:global(.dark) .book-authors .book-year {
  color: #C1121F;
}
:global(.dark) .book-img img {
  box-shadow: 0 2px 12px 0 rgba(0,0,0,0.23);
  background: #002037;
}


</style>