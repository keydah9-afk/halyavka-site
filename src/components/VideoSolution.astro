---
/*
  VideoSolution — модальний переглядач відеорозв’язань до вправ.

  Рендерить лише модалку + логіку. Кнопки-тригери живуть у RatingShare
  (компактна — в ряду «Помилка / Поділитися», широка — окремим рядком нижче)
  і позначені [data-video-cta]; вони самі показуються/ховаються залежно від
  того, чи є відео до поточної вправи.

  Поточна вправа визначається за #hash (ExerciseGallery оновлює його через
  replaceState + hashchange), із запасним варіантом — .ex-btn.is-active.
*/
import { Icon } from 'astro-icon/components';

export interface Props {
  videos: Record<string, string>;
  playlistId?: string;
  noun?: string; // «Вправа» / «Стор.» — як у ExerciseGallery
}

const { videos, playlistId, noun = 'Вправа' } = Astro.props;
---

<div id="vs-modal" class="vs-modal" hidden role="dialog" aria-modal="true" aria-labelledby="vs-title-num">
  <div class="vs-backdrop" data-vs-close></div>

  <div class="vs-panel" id="vs-panel">
    <div class="vs-head" id="vs-head">
      <Icon name="tabler:brand-youtube" class="vs-head__icon" />
      <span class="vs-title">
        <span class="vs-title__long">Відеорозв’язання · </span><span id="vs-title-num"></span>
      </span>

      <div class="vs-head__tools">
        <button type="button" class="vs-tool" data-vs-move="-1" aria-label="Підняти вікно" title="Підняти вікно">
          <Icon name="tabler:arrow-up" class="vs-tool__icon" />
        </button>
        <button type="button" class="vs-tool" data-vs-move="1" aria-label="Опустити вікно" title="Опустити вікно">
          <Icon name="tabler:arrow-down" class="vs-tool__icon" />
        </button>
        <button type="button" class="vs-tool vs-tool--close" data-vs-close aria-label="Закрити" title="Закрити">
          <Icon name="tabler:x" class="vs-tool__icon" />
        </button>
      </div>
    </div>

    <div class="vs-frame"><div class="vs-slot" id="vs-slot"></div></div>

    <div class="vs-foot">
      <a id="vs-yt" class="vs-link" href="#" target="_blank" rel="noopener">
        <Icon name="tabler:brand-youtube" class="vs-link__icon" /> Дивитись на YouTube
      </a>
      {playlistId && (
        <a
          class="vs-link"
          href={`https://www.youtube.com/playlist?list=${playlistId}`}
          target="_blank"
          rel="noopener"
        >
          <Icon name="tabler:movie" class="vs-link__icon" /> Усі відео книги
        </a>
      )}
      <span class="vs-hint">Поверніть телефон — відео на весь екран</span>
    </div>
  </div>
</div>

<style>
  /* ── Кнопки-тригери (розмітка — в RatingShare) ─────────────────────────── */
  :global(.vs-cta) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border: none;
    border-radius: 0.5rem;
    background: #c1121f;
    color: #fff;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(193, 18, 31, 0.35);
    transition: background-color 0.15s, transform 0.1s, box-shadow 0.15s;
  }
  :global(.vs-cta:hover) {
    background: #a10e1a;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(193, 18, 31, 0.45);
  }
  :global(.vs-cta[hidden]) { display: none !important; }
  :global(.vs-cta__icon) { width: 1.5rem; height: 1.5rem; flex: none; }

  /* Вузькі екрани: іконка зверху, підпис під нею — дрібнішим шрифтом.
     Кнопка розтягується на всю ширину своєї комірки сітки. */
  @media (max-width: 639px) {
    :global(.vs-cta) {
      flex-direction: column;
      gap: 0.1rem;
      padding: 0.35rem 0.5rem;
      line-height: 1.15;
    }
    :global(.vs-cta__label) { font-size: 0.7rem; font-weight: 800; }
    :global(.vs-cta__long) { display: none; }
  }

  /* Широкі екрани: один рядок на всю ширину блока */
  @media (min-width: 640px) {
    :global(.vs-cta) { padding: 0.7rem 1rem; font-size: 1rem; }
    :global(.vs-cta__short) { display: none; }
  }

  /* ── Модалка ───────────────────────────────────────────────────────────── */
  .vs-modal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .vs-modal[hidden] { display: none; }

  .vs-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(2px);
  }

  .vs-panel {
    position: relative;
    width: 100%;
    max-width: 900px;
    background: #003049;
    border: 3px solid #c1121f;
    border-radius: 0.75rem;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    will-change: transform;
  }

  /* Портрет телефона: ні рамки, ні полів — відео на всю ширину екрана.
     Смуга лишається перетягуваною вгору/вниз, просто вона тепер на всю ширину. */
  @media (max-width: 639px) {
    .vs-modal { padding: 0; }
    .vs-panel {
      max-width: none;
      border: 0;
      border-radius: 0;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.7);
    }
    .vs-foot { padding: 0.5rem 0.7rem; }
  }

  .vs-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.6rem 0.5rem 0.75rem;
    background: #003049;
    color: #fdf0d5;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }
  .vs-head.is-dragging { cursor: grabbing; }
  .vs-head__icon { width: 1.4rem; height: 1.4rem; color: #ff4d5a; flex: none; }
  .vs-title {
    flex: 1;
    min-width: 0;
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vs-title__long { color: #cfe0ea; font-weight: 600; }
  @media (max-width: 479px) {
    .vs-title__long { display: none; }
  }
  .vs-head__tools { display: flex; align-items: center; gap: 0.25rem; flex: none; }
  .vs-tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: none;
    border-radius: 0.4rem;
    background: rgba(255, 255, 255, 0.1);
    color: #fdf0d5;
    cursor: pointer;
    transition: background-color 0.15s;
  }
  .vs-tool:hover { background: rgba(255, 255, 255, 0.22); }
  .vs-tool--close:hover { background: #c1121f; color: #fff; }
  .vs-tool__icon { width: 1.15rem; height: 1.15rem; }

  .vs-frame { background: #000; }
  .vs-slot {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
  }
  .vs-slot :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .vs-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    padding: 0.55rem 0.75rem;
    background: #00263a;
    font-size: 0.82rem;
  }
  .vs-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: #fdf0d5;
    text-decoration: none;
    font-weight: 600;
  }
  .vs-link:hover { color: #ff6b6b; text-decoration: underline; }
  .vs-link__icon { width: 1.05rem; height: 1.05rem; }
  .vs-hint { color: #8fa9ba; margin-left: auto; }

  @media (min-width: 640px) {
    .vs-hint { display: none; }
  }

  /* ── Повний екран у ландшафті телефона ─────────────────────────────────── */
  .vs-modal.is-fullscreen { padding: 0; }
  .vs-modal.is-fullscreen .vs-panel {
    max-width: none;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
    transform: none !important;
    display: flex;
    flex-direction: column;
  }
  .vs-modal.is-fullscreen .vs-head {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0));
    padding-bottom: 1.2rem;
    opacity: 0.3;
    transition: opacity 0.2s;
    cursor: default;
  }
  .vs-modal.is-fullscreen .vs-head:hover,
  .vs-modal.is-fullscreen .vs-head:focus-within { opacity: 1; }
  .vs-modal.is-fullscreen .vs-head [data-vs-move] { display: none; }
  .vs-modal.is-fullscreen .vs-frame { flex: 1; display: flex; align-items: center; }
  .vs-modal.is-fullscreen .vs-slot { aspect-ratio: auto; height: 100%; }
  .vs-modal.is-fullscreen .vs-foot { display: none; }
</style>

<script define:vars={{ videos, playlistId, noun }}>
  (function () {
    const LANDSCAPE_FS = '(orientation: landscape) and (max-height: 560px)';

    let dragOffset = 0;
    let mql = null;
    let clickHandler = null;
    let keyHandler = null;

    const $ = (sel) => document.getElementById(sel);

    function currentNum() {
      const h = decodeURIComponent((location.hash || '').replace('#', '')).trim();
      if (h) return h;
      // Запасний варіант — активна кнопка галереї (нова .ex-btn / стара .gallery-thumb-btn)
      const act = document.querySelector('.ex-btn.is-active, .gallery-thumb-btn.active-thumb');
      return act ? act.dataset.num || act.dataset.imageId || '' : '';
    }

    function applyOffset() {
      const panel = $('vs-panel');
      if (panel) panel.style.transform = dragOffset ? 'translateY(' + dragOffset + 'px)' : '';
    }

    /** Не даємо перетягнути вікно так, щоб шапка (за яку тягнуть) пішла за екран. */
    function clampOffset(v) {
      const panel = $('vs-panel');
      if (!panel) return v;
      const vh = window.innerHeight;
      const ph = panel.offsetHeight;
      const top0 = (vh - ph) / 2; // стартова позиція верху панелі (flex-центрування)
      const min = ph <= vh ? -top0 : vh - ph - top0;
      const max = ph <= vh ? vh - 72 - top0 : -top0;
      return Math.max(min, Math.min(max, v));
    }

    function syncFullscreen() {
      const modal = $('vs-modal');
      if (!modal || modal.hidden) return;
      const fs = window.matchMedia(LANDSCAPE_FS).matches;
      modal.classList.toggle('is-fullscreen', fs);
      if (fs) {
        const panel = $('vs-panel');
        if (panel) panel.style.transform = '';
      } else {
        applyOffset();
      }
    }

    /* Адресний рядок браузера прибирається лише справжнім Fullscreen API.
       Викликати його можна тільки під час дії користувача, тому просимо повний
       екран на тапі по кнопці — і він переживає поворот телефона. На десктопі
       не чіпаємо (там вікно й так велике), на iPhone Safari метод відсутній —
       тихо лишаємось на CSS-емуляції. */
    function isTouch() {
      return window.matchMedia('(pointer: coarse)').matches;
    }

    function enterNativeFullscreen(el) {
      if (!el || !isTouch()) return;
      if (document.fullscreenElement || document.webkitFullscreenElement) return;
      const req = el.requestFullscreen || el.webkitRequestFullscreen;
      if (!req) return;
      try {
        const p = req.call(el, { navigationUI: 'hide' });
        if (p && p.catch) p.catch(() => {});
      } catch (_) {
        /* браузер відмовив — не критично, лишається звичайна модалка */
      }
    }

    function exitNativeFullscreen() {
      if (!document.fullscreenElement && !document.webkitFullscreenElement) return;
      const exit = document.exitFullscreen || document.webkitExitFullscreen;
      if (!exit) return;
      try {
        const p = exit.call(document);
        if (p && p.catch) p.catch(() => {});
      } catch (_) {
        /* вже вийшли */
      }
    }

    let lastTrigger = null;

    function openModal(num, trigger) {
      const vid = videos[num];
      if (!vid) return;
      lastTrigger = trigger || null;
      const modal = $('vs-modal');
      const slot = $('vs-slot');
      if (!modal || !slot) return;

      const iframe = document.createElement('iframe');
      iframe.src =
        'https://www.youtube-nocookie.com/embed/' +
        vid +
        '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
      iframe.title = 'Відеорозв’язання — ' + noun + ' ' + num;
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.setAttribute('allowfullscreen', '');
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      slot.replaceChildren(iframe);

      const titleNum = $('vs-title-num');
      if (titleNum) titleNum.textContent = noun + ' ' + num;
      const yt = $('vs-yt');
      if (yt) yt.href = 'https://www.youtube.com/watch?v=' + vid + (playlistId ? '&list=' + playlistId : '');

      dragOffset = 0;
      applyOffset();
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      // Поки ми всередині кліку — просимо повний екран (потім вже не дозволять)
      enterNativeFullscreen(modal);
      syncFullscreen();
      const closeBtn = modal.querySelector('.vs-tool--close');
      if (closeBtn) closeBtn.focus({ preventScroll: true });
    }

    function closeModal() {
      const modal = $('vs-modal');
      if (!modal || modal.hidden) return;
      exitNativeFullscreen();
      modal.hidden = true;
      modal.classList.remove('is-fullscreen');
      const slot = $('vs-slot');
      if (slot) slot.replaceChildren(); // прибираємо iframe → зупиняється звук
      const panel = $('vs-panel');
      if (panel) panel.style.transform = '';
      dragOffset = 0;
      document.body.style.overflow = '';
      if (lastTrigger && document.contains(lastTrigger) && !lastTrigger.hidden) {
        lastTrigger.focus({ preventScroll: true });
      }
      lastTrigger = null;
    }

    /** Показує/ховає кнопки-тригери під поточну вправу. */
    function syncCta() {
      const num = currentNum();
      const has = Object.prototype.hasOwnProperty.call(videos, num);
      document.querySelectorAll('[data-video-cta]').forEach((btn) => {
        btn.hidden = !has;
        btn.dataset.videoNum = has ? num : '';
        const label = btn.querySelector('.vs-cta__num');
        if (label) label.textContent = has ? '№' + num : '';
      });
      // Прибрана кнопка не має лишати по собі порожній рядок сітки
      document.querySelectorAll('.rating-share-widget.has-video').forEach((w) => {
        w.classList.toggle('video-off', !has);
      });
      if (!has) closeModal();
    }

    function initVideoSolution() {
      const modal = $('vs-modal');
      const head = $('vs-head');
      if (!modal || !head) return;
      if (modal.dataset.initialized === 'true') return;
      modal.dataset.initialized = 'true';

      clickHandler = (e) => {
        const t = e.target;
        if (!t || !t.closest) return;
        const cta = t.closest('[data-video-cta]');
        if (cta) {
          e.preventDefault();
          openModal(cta.dataset.videoNum || currentNum(), cta);
          return;
        }
        if (t.closest('[data-vs-close]')) closeModal();
      };
      document.addEventListener('click', clickHandler);

      head.querySelectorAll('[data-vs-move]').forEach((b) => {
        b.addEventListener('click', (e) => {
          e.stopPropagation();
          dragOffset = clampOffset(dragOffset + Number(b.dataset.vsMove) * 80);
          applyOffset();
        });
      });

      // Перетягування за шапку — тільки по вертикалі
      let startY = 0;
      let startOffset = 0;
      let pid = null;
      head.addEventListener('pointerdown', (e) => {
        if (e.target.closest('button')) return;
        if (modal.classList.contains('is-fullscreen')) return;
        pid = e.pointerId;
        startY = e.clientY;
        startOffset = dragOffset;
        head.classList.add('is-dragging');
        head.setPointerCapture(pid);
      });
      head.addEventListener('pointermove', (e) => {
        if (pid === null || e.pointerId !== pid) return;
        dragOffset = clampOffset(startOffset + (e.clientY - startY));
        applyOffset();
      });
      const endDrag = (e) => {
        if (pid === null || (e && e.pointerId !== pid)) return;
        try {
          head.releasePointerCapture(pid);
        } catch (_) {
          /* капчу вже знято */
        }
        pid = null;
        head.classList.remove('is-dragging');
      };
      head.addEventListener('pointerup', endDrag);
      head.addEventListener('pointercancel', endDrag);

      // Поворот екрана → повний екран і назад.
      // Слухаємо і matchMedia, і resize/orientationchange — у деяких браузерах
      // подія 'change' на MediaQueryList під час повороту не приходить.
      mql = window.matchMedia(LANDSCAPE_FS);
      if (mql.addEventListener) mql.addEventListener('change', syncFullscreen);
      else mql.addListener(syncFullscreen);
      window.addEventListener('resize', syncFullscreen);
      window.addEventListener('orientationchange', syncFullscreen);
      document.addEventListener('fullscreenchange', syncFullscreen);
      document.addEventListener('webkitfullscreenchange', syncFullscreen);

      keyHandler = (e) => {
        if (e.key === 'Escape') closeModal();
      };
      document.addEventListener('keydown', keyHandler);
      window.addEventListener('hashchange', syncCta);

      syncCta();
      // ExerciseGallery ініціалізується після завантаження картинки — досинхронізуємось
      setTimeout(syncCta, 400);
    }

    function cleanup() {
      closeModal();
      if (mql) {
        if (mql.removeEventListener) mql.removeEventListener('change', syncFullscreen);
        else mql.removeListener(syncFullscreen);
        mql = null;
      }
      if (clickHandler) {
        document.removeEventListener('click', clickHandler);
        clickHandler = null;
      }
      if (keyHandler) {
        document.removeEventListener('keydown', keyHandler);
        keyHandler = null;
      }
      window.removeEventListener('hashchange', syncCta);
      window.removeEventListener('resize', syncFullscreen);
      window.removeEventListener('orientationchange', syncFullscreen);
      document.removeEventListener('fullscreenchange', syncFullscreen);
      document.removeEventListener('webkitfullscreenchange', syncFullscreen);
    }

    document.addEventListener('astro:page-load', initVideoSolution);
    document.addEventListener('astro:before-swap', cleanup);
    if (document.readyState !== 'loading') initVideoSolution();
  })();
</script>
