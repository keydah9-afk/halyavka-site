---
/*
  ExerciseGallery — кнопки вправ, згруповані по §/темах (усі відкриті), а нижче — переглядач.

  Порядок під мобільний трафік: спершу вибір номера (теми відкриті), клік → «переносить»
  до картинки нижче. Переглядач/пошук/«← →»/зум/deep-link #N/запис #hash — як в ImageGallery.
*/
type ExItem = number | string | { file: string; label: string | number };
interface Topic {
  title: string;
  numbers: ExItem[];
  collapsed?: boolean; // якщо true — акордеон згорнутий за замовчуванням (напр. самоперевірки)
}
interface Paragraph {
  title: string;
  topics: Topic[];
}
interface Section {
  rozdil: string;
  paragraphs: Paragraph[];
}

export interface Props {
  id: string;
  base: string;
  sections: Section[];
  povtorennya?: Topic;
}

const { id, base, sections, povtorennya } = Astro.props;

// Кожен елемент numbers — або число/рядок (підпис = ім'я файлу), або пара
// { file, label } для картинок зі складним ім'ям (напр. z-d-s-1-vprava-1 з підписом «1»).
const norm = (v: ExItem): { id: string; label: string } =>
  v !== null && typeof v === 'object'
    ? { id: String(v.file), label: String(v.label) }
    : { id: String(v), label: String(v) };

const allItems = [
  ...sections.flatMap((s) => s.paragraphs.flatMap((p) => p.topics.flatMap((t) => t.numbers))),
  ...(povtorennya?.numbers ?? []),
].map(norm);
const flat: string[] = allItems.map((i) => i.id);
const idxOf = new Map<string, number>(flat.map((id, i) => [id, i]));
const first = flat[0];
---

<div id={id} class="ex-root">
  <div class="ex-toc">
    {sections.map((s) => (
      <section class="ex-section">
        <h2 class="ex-rozdil">{s.rozdil}</h2>
        {s.paragraphs.map((p) => (
          <div class="ex-para">
            <h3 class="ex-para-title">{p.title}</h3>
            {p.topics.map((t) => (
              <details class="ex-topic" open={!t.collapsed}>
                <summary class="ex-summary">
                  <span>{t.title}</span>
                </summary>
                <div class="ex-grid">
                  {t.numbers.map((raw) => {
                    const it = norm(raw);
                    return (
                      <button type="button" class="ex-btn" data-num={it.id} data-index={idxOf.get(it.id)}>{it.label}</button>
                    );
                  })}
                </div>
              </details>
            ))}
          </div>
        ))}
      </section>
    ))}

    {povtorennya && (
      <section class="ex-section">
        <h2 class="ex-rozdil">Повторення</h2>
        <details class="ex-topic" open>
          <summary class="ex-summary">
            <span>{povtorennya.title}</span>
          </summary>
          <div class="ex-grid">
            {povtorennya.numbers.map((raw) => {
              const it = norm(raw);
              return (
                <button type="button" class="ex-btn" data-num={it.id} data-index={idxOf.get(it.id)}>{it.label}</button>
              );
            })}
          </div>
        </details>
      </section>
    )}
  </div>

  <div class="ex-viewer">
    <div class="ex-viewer-inner">
      <img
        id={`${id}-img`}
        class="ex-img"
        src={`${base}/${first}.webp`}
        alt={`ГДЗ до вправи ${first}`}
        loading="lazy"
        onerror={`if(this.src.indexOf('placeholder.webp')===-1)this.src='/images/placeholder.webp';`}
      />
    </div>

    <div class="ex-controls">
      <div class="ex-search">
        <input
          type="search"
          id={`${id}-search-input`}
          class="ex-search-input"
          placeholder="Пошук за номером"
          inputmode="numeric"
        />
        <button type="button" id={`${id}-search-button`} class="ex-ctrl" title="Знайти">🔍</button>
      </div>
      <div class="ex-actions">
        <span id={`${id}-current-number`} class="ex-current" title="Поточна вправа">Вправа {first}</span>
        <button type="button" id={`${id}-zoom-in`} class="ex-ctrl" title="Збільшити">+</button>
        <button type="button" id={`${id}-zoom-out`} class="ex-ctrl" title="Зменшити">−</button>
        <button type="button" id={`${id}-prev-btn`} class="ex-ctrl" title="Попередня вправа">←</button>
        <button type="button" id={`${id}-next-btn`} class="ex-ctrl" title="Наступна вправа">→</button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ id, base, flat }}>
  function initEx() {
    const root = document.getElementById(id);
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const img = root.querySelector(`#${id}-img`);
    const inner = root.querySelector('.ex-viewer-inner');
    const viewer = root.querySelector('.ex-viewer');
    const zoomIn = root.querySelector(`#${id}-zoom-in`);
    const zoomOut = root.querySelector(`#${id}-zoom-out`);
    const searchInput = root.querySelector(`#${id}-search-input`);
    const searchBtn = root.querySelector(`#${id}-search-button`);
    const curNum = root.querySelector(`#${id}-current-number`);
    const prevBtn = root.querySelector(`#${id}-prev-btn`);
    const nextBtn = root.querySelector(`#${id}-next-btn`);
    if (!img || !inner) return;

    const flatStr = flat.map(String);
    let scale = 1, dragging = false;
    let sx = 0, sy = 0, x = 0, y = 0;
    let rW = 0, rH = 0, cW = 0, cH = 0;
    let active = null;

    const apply = () => { img.style.transform = `translate(${x}px,${y}px) scale(${scale})`; };
    const clamp = () => {
      const maxX = Math.max(0, (rW * scale - cW) / 2);
      const maxY = Math.max(0, (rH * scale - cH) / 2);
      x = Math.max(-maxX, Math.min(x, maxX));
      y = Math.max(-maxY, Math.min(y, maxY));
    };
    const reset = () => { scale = 1; x = 0; y = 0; apply(); img.style.cursor = 'default'; };
    const dims = () => { cW = inner.clientWidth; cH = inner.clientHeight; rW = img.clientWidth || cW; rH = img.clientHeight || cH; reset(); };
    const pt = (e) => (e.touches && e.touches.length ? { x: e.touches[0].clientX, y: e.touches[0].clientY } : { x: e.clientX, y: e.clientY });
    const down = (e) => { if (scale > 1) { dragging = true; img.style.cursor = 'grabbing'; const c = pt(e); sx = c.x - x; sy = c.y - y; e.preventDefault(); } };
    const move = (e) => { if (!dragging) return; const c = pt(e); e.preventDefault(); x = c.x - sx; y = c.y - sy; clamp(); apply(); };
    const up = () => { dragging = false; img.style.cursor = scale > 1 ? 'grab' : 'default'; };

    function show(num, scroll) {
      const target = root.querySelector(`.ex-btn[data-num="${num}"]`);
      if (!target) return;
      reset();
      img.src = `${base}/${num}.webp`;
      img.alt = `ГДЗ до вправи ${target.textContent}`;
      if (curNum) curNum.textContent = 'Вправа ' + target.textContent;
      const det = target.closest('details');
      if (det && !det.open) det.open = true;
      if (window.history && window.history.replaceState) {
        window.history.replaceState(null, '', `#${num}`);
        window.dispatchEvent(new HashChangeEvent('hashchange'));
      }
      if (active) active.classList.remove('is-active');
      target.classList.add('is-active');
      active = target;
      if (scroll && viewer) viewer.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function navigate(dir) {
      if (!active) return;
      const i = parseInt(active.dataset.index, 10) + dir;
      if (i >= 0 && i < flat.length) show(flat[i], false);
    }

    function search() {
      const v = ((searchInput && searchInput.value) || '').trim();
      if (!v) return;
      if (flatStr.includes(v)) {
        show(v, true);
        searchInput.value = '';
        searchInput.classList.remove('ex-search-err');
      } else {
        searchInput.classList.add('ex-search-err');
        setTimeout(() => searchInput.classList.remove('ex-search-err'), 600);
      }
    }

    inner.addEventListener('mousedown', down);
    inner.addEventListener('touchstart', down, { passive: false });
    window.addEventListener('mousemove', move);
    window.addEventListener('touchmove', move, { passive: false });
    window.addEventListener('mouseup', up);
    window.addEventListener('touchend', up);
    window.addEventListener('resize', dims);

    inner.addEventListener('wheel', (e) => {
      e.preventDefault();
      const old = scale;
      scale = e.deltaY < 0 ? scale + 0.1 : Math.max(1, scale - 0.1);
      const r = inner.getBoundingClientRect();
      const mx = e.clientX - r.left, my = e.clientY - r.top;
      x = mx - (mx - x) * (scale / old);
      y = my - (my - y) * (scale / old);
      clamp(); apply();
      if (scale > 1) img.style.cursor = 'grab'; else reset();
    }, { passive: false });

    root.querySelectorAll('.ex-btn').forEach((b) => {
      b.addEventListener('click', () => show(b.dataset.num, true));
    });

    if (zoomIn) zoomIn.addEventListener('click', () => { const o = scale; scale = Math.min(3, scale + 0.2); if (scale > o) { x = 0; y = 0; } clamp(); apply(); if (scale > 1) img.style.cursor = 'grab'; });
    if (zoomOut) zoomOut.addEventListener('click', () => { scale = Math.max(1, scale - 0.2); if (scale === 1) reset(); else { clamp(); apply(); } });
    if (prevBtn) prevBtn.addEventListener('click', () => navigate(-1));
    if (nextBtn) nextBtn.addEventListener('click', () => navigate(1));
    if (searchBtn) searchBtn.addEventListener('click', search);
    if (searchInput) searchInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); search(); } });

    img.addEventListener('load', dims);
    if (img.complete) dims();

    const h = window.location.hash.replace('#', '');
    if (h && /^\d+$/.test(h) && flatStr.includes(h)) {
      show(h, true);
    } else {
      const fb = root.querySelector('.ex-btn');
      if (fb) { fb.classList.add('is-active'); active = fb; }
    }

    root._exCleanup = () => {
      window.removeEventListener('mousemove', move);
      window.removeEventListener('touchmove', move);
      window.removeEventListener('mouseup', up);
      window.removeEventListener('touchend', up);
      window.removeEventListener('resize', dims);
      img.removeEventListener('load', dims);
      root.dataset.initialized = 'false';
    };
  }

  document.addEventListener('astro:page-load', initEx);
  document.addEventListener('astro:before-swap', () => {
    const root = document.getElementById(id);
    if (root && typeof root._exCleanup === 'function') root._exCleanup();
  });
  if (document.readyState !== 'loading') initEx();
</script>

<style>
  .ex-root { max-width: 1000px; width: 92%; margin: 1.25rem auto 0; }

  /* Зміст за темами (зверху) */
  .ex-toc { width: 100%; margin: 0 auto; text-align: left; }
  .ex-rozdil {
    font-size: 1.1rem;
    font-weight: bold;
    color: #c1121f;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 1.2rem 0 0.5rem;
  }
  .ex-para-title { font-size: 1.02rem; font-weight: 700; color: #003049; margin: 0.7rem 0 0.35rem; }
  .ex-topic {
    border: 1px solid #d9e0e5;
    border-radius: 0.5rem;
    margin-bottom: 0.4rem;
    background: #fff;
    overflow: hidden;
  }
  .ex-summary {
    list-style: none;
    cursor: pointer;
    padding: 0.55rem 0.8rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-weight: 600;
    color: #003049;
    font-size: 0.95rem;
  }
  .ex-summary::-webkit-details-marker { display: none; }
  .ex-summary::before { content: '▸'; color: #c1121f; font-weight: bold; margin-right: 0.4rem; transition: transform 0.15s; }
  .ex-topic[open] .ex-summary::before { transform: rotate(90deg); }
  .ex-summary > span:first-of-type { flex: 1; }
  .ex-topic-count {
    flex: none;
    font-size: 0.72rem;
    font-weight: 700;
    color: #6c757d;
    background: #f1f3f5;
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
  }
  .ex-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(46px, 1fr));
    gap: 0.35rem;
    padding: 0.15rem 0.8rem 0.8rem;
  }
  .ex-btn {
    border: 1px solid #003049;
    background: #fff;
    color: #003049;
    border-radius: 0.3rem;
    padding: 0.4rem 0;
    font-size: 0.88rem;
    cursor: pointer;
    transition: background-color 0.12s, color 0.12s;
  }
  .ex-btn:hover { background: #c1121f; color: #fff; border-color: #c1121f; }
  .ex-btn.is-active { background: #c1121f; color: #fff; border-color: #c1121f; }

  /* Переглядач (знизу) */
  .ex-viewer {
    /* Дві рамки навколо всього блока: червона зовні (border) + бежева всередині (inset). */
    border: 6px solid #c1121f;
    background: #fff;
    box-shadow: inset 0 0 0 6px #fdf0d5, 0 4px 10px rgba(0, 0, 0, 0.18);
    padding: 14px;
    max-width: 820px;
    margin: 1.5rem auto 0;
    scroll-margin-top: 80px;
  }
  .ex-viewer-inner {
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    min-height: 20vh;
  }
  .ex-img {
    display: block;
    max-width: 100%;
    height: auto;
    transform-origin: 50% 50%;
    user-select: none;
    -webkit-user-drag: none;
  }
  .ex-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 0.55rem;
    margin-top: 0.6rem;
  }
  .ex-search { display: flex; align-items: center; gap: 0.4rem; }
  .ex-search-input {
    height: 2.6rem;
    min-width: 0;
    width: 175px;
    border: 1px solid #003049;
    border-radius: 0.25rem;
    padding: 0 0.5rem;
    color: #003049;
  }
  .ex-search-input:focus { outline: none; border-color: #c1121f; box-shadow: 0 0 0 2px rgba(193, 18, 31, 0.3); }
  .ex-search-input.ex-search-err { border-color: #c1121f; animation: ex-shake 0.5s ease-in-out; }
  @keyframes ex-shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }
  .ex-actions { display: flex; align-items: center; gap: 0.4rem; }
  .ex-current {
    font-weight: bold;
    color: #c1121f;
    text-align: center;
    font-size: 1.02rem;
    white-space: nowrap;
    padding-right: 0.2rem;
  }
  .ex-ctrl {
    background: #003049;
    color: #fff;
    height: 2.6rem;
    min-width: 2.6rem;
    padding: 0 0.6rem;
    border: none;
    border-radius: 0.25rem;
    font-weight: bold;
    font-size: 1.3rem;
    cursor: pointer;
    transition: background-color 0.15s, transform 0.1s;
  }
  .ex-ctrl:hover { background: #c1121f; transform: translateY(-1px); }

  @media (max-width: 600px) {
    .ex-root { width: 98%; }
    .ex-grid { grid-template-columns: repeat(auto-fill, minmax(42px, 1fr)); }
  }

  /* Темна тема */
  :global(.dark) .ex-viewer { border-color: #8d0000; }
  :global(.dark) .ex-viewer-inner { border-color: #0b3a55; background: #fff; }
  :global(.dark) .ex-rozdil { color: #ff6b6b; }
  :global(.dark) .ex-para-title { color: #fdf0d5; }
  :global(.dark) .ex-topic { background: #001f30; border-color: #0b3a55; }
  :global(.dark) .ex-summary { color: #fdf0d5; }
  :global(.dark) .ex-topic-count { background: #0b3a55; color: #cdd9e1; }
  :global(.dark) .ex-btn { background: #001f30; color: #fdf0d5; border-color: #0b3a55; }
  :global(.dark) .ex-btn:hover, :global(.dark) .ex-btn.is-active { background: #c1121f; color: #fff; border-color: #c1121f; }
  /* .ex-current завжди на білому фоні переглядача → колір #c1121f однаковий в обох темах */
  :global(.dark) .ex-search-input { background: #001f30; color: #fdf0d5; border-color: #0b3a55; }
</style>
