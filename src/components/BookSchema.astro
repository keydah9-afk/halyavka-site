---
/*
  BookSchema — JSON-LD для страницы ГДЗ halyavka.net.

  Рейтинг подтягивается из Supabase на этапе билда (SSG).
  Если голосов мало (меньше MIN_VOTES) — блок aggregateRating не рендерится,
  чтобы не раздражать Google Rich Results "рейтингом из одной оценки".
*/

import type { ImageMetadata } from 'astro';
import { supabase } from '~/lib/supabase';

interface Props {
  title: string;
  author: string;
  year: string | number;
  description: string;
  coverImage: ImageMetadata;
  pageTitle: string;
  pageDescription: string;
  textbookName?: string;
  dateModified?: Date;
}

const {
  title,
  author,
  year,
  description,
  coverImage,
  pageTitle,
  pageDescription,
  textbookName,
  dateModified = new Date(),
} = Astro.props;

const pageUrl = Astro.url.href;
const origin = Astro.url.origin;
const imageUrl = `${origin}${coverImage.src}`;

const aboutTextbookName = textbookName ?? title.replace(/^ГДЗ\s+/i, '');

// --- Получаем реальный рейтинг из Supabase ---
// bookId = путь страницы с trailing slash, как в book_rating_agg
const bookId = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : Astro.url.pathname + '/';

const MIN_VOTES = 5;

let aggregateRating: Record<string, unknown> | null = null;

try {
  const { data, error } = await supabase
    .from('book_rating_agg')
    .select('likes, dislikes')
    .eq('book_id', bookId)
    .maybeSingle();

  if (error) {
    console.warn(`[BookSchema] Supabase error for ${bookId}:`, error.message);
  } else if (data) {
    const likes = data.likes ?? 0;
    const dislikes = data.dislikes ?? 0;
    const total = likes + dislikes;

    if (total >= MIN_VOTES) {
      // Переводим лайки/дизлайки в шкалу 1-5
      const score = (likes / total) * 4 + 1; // 0% лайков → 1, 100% → 5
      aggregateRating = {
        '@type': 'AggregateRating',
        ratingValue: score.toFixed(1),
        ratingCount: String(total),
        bestRating: '5',
        worstRating: '1',
      };
    }
  }
} catch (e) {
  console.warn(`[BookSchema] Supabase fetch failed for ${bookId}:`, e);
}

// --- Собираем главную сущность Book + LearningResource ---
const bookEntity: Record<string, unknown> = {
  '@type': ['Book', 'LearningResource'],
  '@id': `${pageUrl}#gdz`,
  name: title,
  description: description,
  image: [imageUrl],
  bookFormat: 'https://schema.org/EBook',
  inLanguage: 'uk',
  learningResourceType: 'Answer Key',
  educationalLevel: 'Secondary education',
  educationalUse: 'Self-study',
  audience: {
    '@type': 'EducationalAudience',
    educationalRole: 'student',
  },
  author: {
    '@type': 'Organization',
    '@id': `${origin}/#organization`,
    name: 'Команда halyavka.net',
    url: `${origin}/pro-nas/`,
  },
  publisher: {
    '@id': `${origin}/#organization`,
  },
  isBasedOn: {
    '@type': 'Book',
    name: aboutTextbookName,
    author: {
      '@type': 'Person',
      name: author,
    },
    datePublished: String(year),
    inLanguage: 'uk',
  },
};

if (aggregateRating) {
  bookEntity.aggregateRating = aggregateRating;
}

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    bookEntity,
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'uk',
      dateModified: dateModified.toISOString(),
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: imageUrl,
      },
      mainEntity: { '@id': `${pageUrl}#gdz` },
      isPartOf: {
        '@id': `${origin}/#organization`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${origin}/#organization`,
      name: 'Халявка',
      url: `${origin}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${origin}/logo-halyavka.png`,
      },
      sameAs: ['https://t.me/halyavka_net'],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />