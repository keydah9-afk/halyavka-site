---
/*
  BookSchema — JSON-LD для страницы ГДЗ halyavka.net.

  Структура @graph:
    1. Book + LearningResource (это наш ГДЗ)
       - author: команда halyavka.net (кто составил решебник)
       - publisher: halyavka.net (та же организация через @id)
       - isBasedOn: Book (учебник-оригинал с автором)
       - aggregateRating: рейтинг страницы
       - learningResourceType / educationalUse / audience — семантика для Google и AI-поиска
    2. WebPage — метаданные самой страницы
    3. Organization (halyavka.net) — определяется один раз, переиспользуется через @id

  Важные моменты:
    - @type у главной сущности — массив ['Book', 'LearningResource'].
      Это даёт rich result со звёздами (от Book) + семантику "учебного материала" (от LearningResource).
    - isBasedOn используется вместо about — это семантически точнее для производной работы.
    - Видимый "name" страницы не меняем — по нему уже идут клики в выдаче.
*/

import type { ImageMetadata } from 'astro';

export interface Props {
  /** Название страницы ГДЗ, например "ГДЗ математика 6 клас — Бевз 1 частина" */
  title: string;
  /** Автор(ы) учебника-оригинала, например "Г. Бевз, Д. Васильєва, Н. Владімірова" */
  author: string;
  /** Год издания оригинального учебника */
  year: string | number;
  /** Описание ГДЗ */
  description: string;
  /** Обложка (Astro Image object) */
  coverImage: ImageMetadata;
  /** Title для <WebPage> (длинный SEO-title) */
  pageTitle: string;
  /** Description для <WebPage> */
  pageDescription: string;
  /** Название оригинального учебника (если отличается от title ГДЗ) */
  textbookName?: string;
  /** Дата последнего изменения страницы (по умолчанию — текущая дата билда) */
  dateModified?: Date;
  /** Рейтинг */
  rating?: {
    value: string;
    count: string | number;
    best?: string;
    worst?: string;
  };
}

const {
  title,
  author,
  year,
  description,
  coverImage,
  pageTitle,
  pageDescription,
  textbookName,
  dateModified = new Date(),
  rating = {
    value: '4.8',
    count: '66',
    best: '5',
    worst: '1',
  },
} = Astro.props;

const pageUrl = Astro.url.href;
const origin = Astro.url.origin;
const imageUrl = `${origin}${coverImage.src}`;

// Имя учебника для isBasedOn. Если не передано — берём title без префикса "ГДЗ "
const aboutTextbookName = textbookName ?? title.replace(/^ГДЗ\s+/i, '');

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      // Двойной тип: Book даёт звёзды в выдаче, LearningResource — семантику учебного материала
      '@type': ['Book', 'LearningResource'],
      '@id': `${pageUrl}#gdz`,
      name: title,
      description: description,
      image: [imageUrl],
      bookFormat: 'https://schema.org/EBook',
      inLanguage: 'uk',

      // --- LearningResource-свойства ---
      // Тип учебного ресурса — "сборник ответов", стандартное значение schema.org
      learningResourceType: 'Answer Key',
      // Уровень образования — средняя школа (2-10 классы)
      educationalLevel: 'Secondary education',
      // Основное назначение — самоподготовка
      educationalUse: 'Self-study',
      audience: {
        '@type': 'EducationalAudience',
        educationalRole: 'student',
      },

      // --- Автор и издатель решебника ---
      author: {
        '@type': 'Organization',
        '@id': `${origin}/#organization`,
        name: 'Команда halyavka.net',
        url: `${origin}/pro-nas/`,
      },
      publisher: {
        '@id': `${origin}/#organization`,
      },

      // --- На основе чего сделан ГДЗ: оригинальный учебник ---
      isBasedOn: {
        '@type': 'Book',
        name: aboutTextbookName,
        author: {
          '@type': 'Person',
          name: author,
        },
        datePublished: String(year),
        inLanguage: 'uk',
      },

      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: rating.value,
        ratingCount: String(rating.count),
        bestRating: rating.best ?? '5',
        worstRating: rating.worst ?? '1',
      },
    },
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'uk',
      dateModified: dateModified.toISOString(),
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: imageUrl,
      },
      mainEntity: { '@id': `${pageUrl}#gdz` },
      isPartOf: {
        '@id': `${origin}/#organization`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${origin}/#organization`,
      name: 'Халявка',
      url: `${origin}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${origin}/logo-halyavka.png`,
      },
      sameAs: [
        'https://t.me/halyavka_net',
        // Сюда можно добавить Facebook, YouTube, Instagram когда будут
      ],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />