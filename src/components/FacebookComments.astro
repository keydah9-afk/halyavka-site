const postId = postMap[currentPath];
const channelName = "halyavka_net";
const discussionPath = `${channelName}/${postId}`;
---

{postId ? (
  <div class="telegram-comments-wrapper" id="tg-comments-container">
    <button id="load-comments-btn" class="tg-load-btn" data-discussion={discussionPath}>
      Показати коментарі
    </button>
    
    <div id="tg-widget-area"></div>
  </div>

  <script is:inline>
    function loadTgComments() {
      const btn = document.getElementById('load-comments-btn');
      const widgetArea = document.getElementById('tg-widget-area');

      // Если кнопки на странице нет, прерываем работу
      if (!btn || !widgetArea) return;

      // Используем onclick напрямую, чтобы избежать двойных срабатываний
      btn.onclick = function() {
        const discussionPath = this.getAttribute('data-discussion');

        // Создаем элемент скрипта
        const script = document.createElement('script');
        script.src = 'https://telegram.org/js/telegram-widget.js?22';
        script.setAttribute('data-telegram-discussion', discussionPath);
        script.setAttribute('data-comments-limit', '5');
        script.setAttribute('data-color', '343638');
        script.setAttribute('data-dark-color', 'FFFFFF');
        script.async = true;

        // Очищаем контейнер на всякий случай и вставляем скрипт
        widgetArea.innerHTML = '';
        widgetArea.appendChild(script);

        // Скрываем кнопку
        this.style.display = 'none';
      };
    }

    // Запускаем функцию сразу, как только браузер дошел до этого места
    loadTgComments();

    // Запасной вариант: если Astro использует View Transitions (переходы без перезагрузки)
    document.addEventListener('astro:page-load', loadTgComments);
  </script>
) : (
  <div class="telegram-comments-wrapper empty-comments">
    <p style="text-align: center; color: #666;">Коментарі до цього розділу з'являться згодом.</p>
  </div>
)}

<style>
  .telegram-comments-wrapper {
    margin-top: 2rem;
    width: 100%;
    min-height: 50px; /* Уменьшили высоту, так как виджета пока нет */
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  /* Стили для нашей новой кнопки */
  .tg-load-btn {
    background-color: #003049; /* Темный цвет, под дизайн вашей старой кнопки */
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 12px 24px;
    font-size: 16px;
    cursor: pointer;
    transition: background-color 0.3s;
    width: 100%;
    max-width: 400px;
    font-weight: bold;
  }

  .tg-load-btn:hover {
    background-color: #003049;
  }

  #tg-widget-area {
    width: 100%;
  }

  .empty-comments {
    background: #f9f9f9;
    border-radius: 8px;
    padding: 20px;
  }
</style>