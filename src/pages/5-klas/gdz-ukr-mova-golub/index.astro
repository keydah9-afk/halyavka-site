// Для нового учебника: измените '5-mat-bedenko-2022-gdz.webp' на имя файла новой обложки.
import coverImage from '../../../assets/images/covers/5-ukr-mova-golub-2022-gdz.webp'; 

// 2. СПИСОК НОМЕРОВ КАРТИНОК ГАЛЕРЕИ
// Перечислите все номера страниц ГДЗ, которые у вас есть в папке public/images/5-klas/gdz-matematyka-merzlyak/
// Для нового учебника: обновите этот массив номерами страниц нового ГДЗ.
const images = [5, 7, 13, 16, 23, 26, 27, 28, 29, 30, 31, 34, 35, 36, 39, 40, 41, 42, 43, 44, 48, 50, 51, 53, 55, 56, 57, 58, 60, 63, 65, 66, 68, 71, 73, 74, 75, 78, 80, 83, 84, 85, 86, 88, 89, 92, 94, 96, 97, 99, 101, 103, 104, 106, 107, 108, 109, 111, 112, 115, 116, 117, 118, 121, 122, 123, 124-1 , 124-2 , 125, 127, 128, 129, 130, 131, 132, 133, 135, 136, 137, 138, 139, 140, 141, 142, 143, 144, 145, 146, 147, 148, 149, 150, 151, 152, 153, 154, 155, 156, 158, 159, 160, 161, 163, 164, 165, 166, 167, 168, 169, 170, 171, 172, 173, 176, 177, 178, 179, 180, 181, 182, 184, 185, 186, 188, 189, 190, 192, 193, 195, 198, 200, 201, 202, 203, 204, 205, 206, 210, 211, 212, 213, 214, 216, 217, 218, 220, 223, 224, 226, 227, 228, 229, 231, 232, 234, 238, 240, 241, 244, 246, 247, 248, 250, 251, 252, 253, 254, 255, 256, 258, 259, 260, 261, 262, 263, 264, 266, 268, 269, 270, 271, 272, 273, 275, 276, 277, 278, 282, 283, 284, 286, 287, 288, 290, 291, 292, 294, 295, 296, 299, 300, 301, 305, 307, 309, 310, 311, 312, 313, 315, 317, 318, 319, 320, 322, 324, 325, 326, 327, 328, 331, 333, 334, 336, 337, 338, 339, 340, 342, 345, 346, 349, 350, 351, 352, 355, 356, 358, 362, 364, 368, 369, 370, 371, 372, 373, 378, 379, 382, 383, 384, 385, 389, 390, 391, 392, 393, 394, 395, 396, 397, 402, 403, 405, 406, 407, 409, 410, 411, 412, 414, 415, 417, 419, 421, 425, 426, 427, 429, 430, 431, 432, 435, 436, 437, 438, 439, 441, 443, 444, 445, 446, 448, 449, 450, 451, 452, 453, 454, 456, 457, 459, 460, 461, 463, 465, 466, 468, 469, 470, 471, 473, 476, 477, 479, 480, 481, 482, 483, 484, 488, 489, 490, 491, 492, 494, 495, 496, 498, 499, 500, 501, 502, 504, 505, 506, 508, 509, 510, 511, 512, 513, 514, 515, 517, 518, 519, 522, 523, 524, 525, 527, 529, 530, 531, 533, 535, 540, 541, 542, 543, 546, 549, 550, 553, 555, 556, 560, 561, 562, 563, 565, 566, 567, 569, 570, 571, 575, 577, 578, 580, 583, 584, 586, 590, 591, 592, 593, 597, 601, 602, 604, 605, 606, 608, 611, 612, 613, 614, 619, 623, 624, 626, 627, 628, 629, 630, 632, 640, 641, 642, 646, 648, 650, 651, 652


];

// 3. ОСНОВНЫЕ ДАННЫЕ О КНИГЕ
// Для нового учебника: обновите эти переменные.
const title = 'ГДЗ українська мова 5 клас — Голуб';
const author = 'Н. Голуб, О. Горошкіна';
const year = '2022';
const description = "Повне ГДЗ вправ до підручника “Українська мова, 5 клас” Н. Голуб, О. Горошкіна. Усі завдання з докладним поясненням і рішеннями, складені відповідно до навчальної програми.";
const typegdz = 'ГДЗ';


// 4. SEO МЕТАДАННЫЕ ДЛЯ СТРАНИЦЫ
const pageSeoProps = {
  title: `${title} - Відповіді до підручника | halyavka.net`,
  shortTitle: title,
  description: description,
  canonical: String(Astro.url.href),
  openGraph: {
    // 👇 ИСПРАВЛЕНИЕ ЗДЕСЬ 👇
    images: [
      {
        url: coverImage, // <--- Передаем ОБЪЕКТ coverImage, а не coverImage.src
        alt: title,
      }
    ],
    type: 'book',
    locale: 'uk_UA', 
  },
  twitter: {
    card: 'summary_large_image',
    image: coverImage, // <--- Тут тоже лучше передать объект, Astro сам разберется
  },
};

// 5. БАЗОВЫЙ ПУТЬ К ИЗОБРАЖЕНИЯМ ГАЛЕРЕИ В PUBLIC/
// Это путь к папке с изображениями страниц ГДЗ внутри public/images/
// Для нового учебника: измените 'gdz-matematyka-bedenko' на имя папки нового ГДЗ.
const galleryBasePath = "/images/5-klas/gdz-ukr-mova-golub";

---

{/* Компонент PageLayout включает <head> и <body>, а также общие стили */}
<PageLayout metadata={pageSeoProps}>



  <BookSchema
    title={title}
    author={author}
    year={year}
    description={description}
    coverImage={coverImage}
    pageTitle={pageSeoProps.title}
    pageDescription={pageSeoProps.description}
  />
  <main itemprop="mainContentOfPage" class="text-center">

    <BookCover
      title={title}
      author={author}
      year={year}
      img={coverImage} // Передаем ИМПОРТИРОВАННЫЙ ОБЪЕКТ coverImage
      alt={`${title} обкладинка`} // Альтернативный текст для изображения
      description={description}
      typegdz={typegdz}
    />
    
    <ImageGallery
      id="gallery2"
      base={galleryBasePath} // Используем переменную для базового пути
      list={images}
    />
    </main>

<div class="flex justify-center my-4">
  <a
    href="/5-klas/"
    class="
      inline-flex items-center justify-center
      h-[40px] min-w-[42px] px-4
      rounded-[7px] border-4 border-[#C1121F]
      bg-[#033049]
      font-semibold text-[21px] text-white
      transition duration-150 ease-in-out
      hover:-translate-y-1 hover:shadow-lg
      shadow-none
      hover:bg-[#204060]
      active:bg-[#045]
    "
  >
    <span>Усі гдз для 5 класу</span>
  </a>
</div>
<RatingShare classTitle={title} />


<RecentlyViewed />
  <GdzTracker pageTitle={title} />

<div class="max-w-4xl mx-auto px-4">
      <FacebookComments />
  </div>
</PageLayout>
