const year = '2022';
const description = "Повне ГДЗ вправ до підручника “Українська мова, 5 клас” Г. Панчук, Б. Близнюк,, О. Приведа. Усі вправи з докладним поясненням і розв'язком, складені відповідно до навчальної програми.";
const typegdz = 'ГДЗ';


// 4. SEO МЕТАДАННЫЕ ДЛЯ СТРАНИЦЫ
const pageSeoProps = {
  title: `${title} - Відповіді до підручника | halyavka.net`,
