---
import PageLayout from '../../../layouts/PageLayout.astro';
import ImageGallery from '../../../components/ImageGallery.astro';
import BookCover from '../../../components/BookCover.astro';
import RatingShare from '~/components/widgets/RatingShare.astro';
import FacebookComments from '~/components/FacebookComments.astro'; 
import RecentlyViewed from '../../../components/RecentlyViewed.astro';

import BookSchema from '../../../components/BookSchema.astro';
import GdzTracker from '../../../components/GdzTracker.astro';
// === МЕСТА ДЛЯ ИЗМЕНЕНИЙ ДЛЯ НОВОГО УЧЕБНИКА ===

// 1. ИМПОРТ ОБЛОЖКИ КНИГИ
// Укажите правильный относительный путь к файлу обложки в папке src/assets/images/covers/
// Для нового учебника: измените '5-mat-bedenko-2022-gdz.webp' на имя файла новой обложки.
import coverImage from '../../../assets/images/covers/9-ukr-mova-zabol.webp'; 

// 2. СПИСОК НОМЕРОВ КАРТИНОК ГАЛЕРЕИ
// Перечислите все номера страниц ГДЗ, которые у вас есть в папке public/images/5-klas/gdz-matematyka-merzlyak/
// Для нового учебника: обновите этот массив номерами страниц нового ГДЗ.
const images = ["3", "5", "8", "11", "12", "16", "17", "18", "20", "26", "27", "31", "32", "33", "37", "40", "41", "44", "46", "52", "60", "61", "65", "69", "75", "81", "91", "93", "98", "105", "106", "112", "114", "121", "122", "123", "124", "127", "130", "150", "153", "155", "157", "159", "163", "164", "166", "168", "170", "171", "173", "174", "175", "180", "182", "184", "187", "188", "195", "196", "198", "200", "202", "204", "205", "206", "209", "210", "213", "216", "220", "221", "222", "227", "232", "233", "235", "240", "241", "243", "246", "248", "250", "253", "256", "258", "260", "264", "268", "270", "277", "280", "284", "293", "297", "305", "307", "310", "314", "317", "321", "322", "324", "332", "336", "337", "339", "345", "348", "350", "360", "362", "368", "371", "372", "374", "375", "376", "378", "381", "383", "395", "398", "400", "404", "413", "416", "426", "435", "437", "440", "449", "450", "453", "454", "455", "456", "457", "459", "461", "464", "467", "474", "477", "479"


];

// 3. ОСНОВНЫЕ ДАННЫЕ О КНИГЕ
// Для нового учебника: обновите эти переменные.
const title = 'ГДЗ українська мова 9 клас — Заболотний';
const author = 'О. Заболотний, В. Заболотний';
const year = '2017';
const description = "Повне ГДЗ вправ до підручника “Українська мова, 9 клас” О. Заболотний, В. Заболотний. Усі вправи з докладним поясненням і розв'язком, складені відповідно до навчальної програми.";
const typegdz = 'ГДЗ';


// 4. SEO МЕТАДАННЫЕ ДЛЯ СТРАНИЦЫ
const pageSeoProps = {
  title: `${title} - Відповіді до підручника`,
  shortTitle: title,
  description: description,
  canonical: String(Astro.url.href),
  openGraph: {
    // 👇 ИСПРАВЛЕНИЕ ЗДЕСЬ 👇
    images: [
      {
        url: coverImage, // <--- Передаем ОБЪЕКТ coverImage, а не coverImage.src
        alt: title,
      }
    ],
    type: 'book',
    locale: 'uk_UA', 
  },
  twitter: {
    card: 'summary_large_image',
    image: coverImage, // <--- Тут тоже лучше передать объект, Astro сам разберется
  },
};

// 5. БАЗОВЫЙ ПУТЬ К ИЗОБРАЖЕНИЯМ ГАЛЕРЕИ В PUBLIC/
// Это путь к папке с изображениями страниц ГДЗ внутри public/images/
// Для нового учебника: измените 'gdz-matematyka-bedenko' на имя папки нового ГДЗ.
const galleryBasePath = "/images/9-klas/gdz-ukr-mova-zabolotnyi";

---

{/* Компонент PageLayout включает <head> и <body>, а также общие стили */}
<PageLayout metadata={pageSeoProps}>



  <BookSchema
    title={title}
    author={author}
    year={year}
    description={description}
    coverImage={coverImage}
    pageTitle={pageSeoProps.title}
    pageDescription={pageSeoProps.description}
  />
  <main itemprop="mainContentOfPage" class="text-center">

    <BookCover
      title={title}
      author={author}
      year={year}
      img={coverImage} // Передаем ИМПОРТИРОВАННЫЙ ОБЪЕКТ coverImage
      alt={`${title} обкладинка`} // Альтернативный текст для изображения
      description={description}
      typegdz={typegdz}
    />
    
    <ImageGallery
      id="gallery2"
      base={galleryBasePath} // Используем переменную для базового пути
      list={images}
    />
    </main>

<div class="flex justify-center my-4">
  <a
    href="/9-klas/"
    class="
      inline-flex items-center justify-center
      h-[40px] min-w-[42px] px-4
      rounded-[7px] border-4 border-[#C1121F]
      bg-[#033049]
      font-semibold text-[21px] text-white
      transition duration-150 ease-in-out
      hover:-translate-y-1 hover:shadow-lg
      shadow-none
      hover:bg-[#204060]
      active:bg-[#045]
    "
  >
    <span>Усі гдз для 9 класу</span>
  </a>
</div>

<RatingShare classTitle={title} />

<RecentlyViewed />
  <GdzTracker pageTitle={title} />

<div class="max-w-4xl mx-auto px-4">
      <FacebookComments />
</div>
</PageLayout>