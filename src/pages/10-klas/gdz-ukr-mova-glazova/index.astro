---
import PageLayout from '../../../layouts/PageLayout.astro';
import ImageGallery from '../../../components/ImageGallery.astro';
import BookCover from '../../../components/BookCover.astro';
import RatingShare from '~/components/widgets/RatingShare.astro';
import FacebookComments from '~/components/FacebookComments.astro'; 
import RecentlyViewed from '../../../components/RecentlyViewed.astro';

// === МЕСТА ДЛЯ ИЗМЕНЕНИЙ ДЛЯ НОВОГО УЧЕБНИКА ===

// 1. ИМПОРТ ОБЛОЖКИ КНИГИ
// Укажите правильный относительный путь к файлу обложки в папке src/assets/images/covers/
// Для нового учебника: измените '5-mat-bedenko-2022-gdz.webp' на имя файла новой обложки.
import coverImage from '../../../assets/images/covers/10-ukr-mova-glazova.webp'; 

// 2. СПИСОК НОМЕРОВ КАРТИНОК ГАЛЕРЕИ
// Перечислите все номера страниц ГДЗ, которые у вас есть в папке public/images/5-klas/gdz-matematyka-merzlyak/
// Для нового учебника: обновите этот массив номерами страниц нового ГДЗ.
const images = ["7", "12", "15", "16", "21", "23", "24", "30", "31", "35", "37", "40", "43", "48", "49", "51", "54", "55", "57", "63", "67", "69", "70", "71", "83", "84", "87", "90", "93", "95", "96", "101", "103", "118", "120", "121", "123", "124", "127", "129", "131", "134", "139", "140", "141", "143", "144", "147", "149", "150", "152", "160", "165", "167", "169", "170", "171", "172", "174", "175", "180", "181", "182", "183", "184", "185", "186", "188", "189", "192", "193", "194", "195", "196", "197", "203", "205", "206", "210", "212", "213", "215", "217", "228", "229", "230", "232", "234", "235", "238", "239", "242", "244", "245", "246", "247", "248", "249", "250", "251", "252", "254", "255", "256", "259", "261", "264", "269", "271", "273", "275", "276", "279", "281", "283", "284", "285", "287", "289", "290", "291", "293", "294", "296", "297", "298", "300", "301", "304", "306", "310", "311", "312", "314", "315", "319", "321", "323", "327", "334", "336", "337", "338", "344", "345", "348", "350", "352", "353", "358", "359", "360", "361", "364", "365", "367", "368", "369", "370", "371", "373", "375", "377", "378", "380", "381", "385", "386", "401", "402", "405", "406", "407", "409", "410", "412", "414", "415", "419-420", "421"


];

// 3. ОСНОВНЫЕ ДАННЫЕ О КНИГЕ
// Для нового учебника: обновите эти переменные.
const title = 'ГДЗ українська мова 10 клас — Глазова';
const author = 'О. П. Глазова';
const year = '2018';
const description = "Повне ГДЗ вправ до підручника “Українська мова, 10 клас” О. П. Глазова. Усі вправи з докладним поясненням і розв'язком, складені відповідно до навчальної програми.";
const typegdz = 'ГДЗ';


// 4. SEO МЕТАДАННЫЕ ДЛЯ СТРАНИЦЫ
const pageSeoProps = {
  title: `${title} - Відповіді до підручника | halyavka.net`,
  shortTitle: title,
  description: description,
  canonical: String(Astro.url.href),
  openGraph: {
    // 👇 ИСПРАВЛЕНИЕ ЗДЕСЬ 👇
    images: [
      {
        url: coverImage, // <--- Передаем ОБЪЕКТ coverImage, а не coverImage.src
        alt: title,
      }
    ],
    type: 'book',
    locale: 'uk_UA', 
  },
  twitter: {
    card: 'summary_large_image',
    image: coverImage, // <--- Тут тоже лучше передать объект, Astro сам разберется
  },
};

// 5. БАЗОВЫЙ ПУТЬ К ИЗОБРАЖЕНИЯМ ГАЛЕРЕИ В PUBLIC/
// Это путь к папке с изображениями страниц ГДЗ внутри public/images/
// Для нового учебника: измените 'gdz-matematyka-bedenko' на имя папки нового ГДЗ.
const galleryBasePath = "/images/10-klas/gdz-ukr-mova-glazova";

// Вспомогательная переменная для Schema.org, генерирующая пути к изображениям галереи
const galleryImagesForSchema = images.map(num => ({
  url: `${Astro.url.origin}${galleryBasePath}/${num}.webp`, // Предполагается .webp, измените если другой формат
}));
---

{/* Компонент PageLayout включает <head> и <body>, а также общие стили */}
<PageLayout metadata={pageSeoProps}>


  {/* JSON-LD Schema.org для улучшения отображения в поисковой выдаче */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "http://schema.org",
    "@graph": [
      {
        "@type": ["WebPage", "ItemPage"], // WebPage для страницы, ItemPage для конкретного элемента
        "name": pageSeoProps.title, 
        "description": pageSeoProps.description, 
        "url": pageSeoProps.canonical, 
        "image": coverImage.src, // URL обложки книги
        "mainEntity": {
          "@type": "Book",
          "name": title,
          "author": {
            "@type": "Person",
            "name": author
          },
          
          "datePublished": year,
          "description": description,
          "image": coverImage.src, // URL обложки книги
          "bookFormat": "https://schema.org/EBook", // Или другое подходящее значение
          "potentialAction": {
            "@type": "ReadAction",
            "target": pageSeoProps.canonical // Ссылка на текущую страницу
          }
        }
      },
      // Дополнительный раздел для галереи изображений, если это применимо
      {
        "@type": "ImageGallery",
        "name": `Галлерея изображений ГДЗ ${title}`,
        "description": `Все страницы ГДЗ для учебника ${title}`,
        "associatedMedia": galleryImagesForSchema.map(img => ({
          "@type": "ImageObject",
          "contentUrl": img.url
        }))
      }
    ]
  })} />

  <main itemprop="mainContentOfPage" class="text-center">

    <BookCover
      title={title}
      author={author}
      year={year}
      img={coverImage} // Передаем ИМПОРТИРОВАННЫЙ ОБЪЕКТ coverImage
      alt={`${title} обкладинка`} // Альтернативный текст для изображения
      description={description}
      typegdz={typegdz}
    />
    
    <ImageGallery
      id="gallery2"
      base={galleryBasePath} // Используем переменную для базового пути
      list={images}
    />
    </main>

<div class="flex justify-center my-4">
  <a
    href="/10-klas/"
    class="
      inline-flex items-center justify-center
      h-[40px] min-w-[42px] px-4
      rounded-[7px] border-4 border-[#C1121F]
      bg-[#033049]
      font-semibold text-[21px] text-white
      transition duration-150 ease-in-out
      hover:-translate-y-1 hover:shadow-lg
      shadow-none
      hover:bg-[#204060]
      active:bg-[#045]
    "
  >
    <span>Усі гдз для 10 класу</span>
  </a>
</div>
<RatingShare classTitle={title} />

<RecentlyViewed />

<script is:inline define:vars={{ pageTitle: title, pageUrl: Astro.url.pathname }}>
  window.__halyavkaPageData = { pageTitle, pageUrl };
</script>

<script>
  import { trackView } from '~/scripts/recently-viewed';

  function setupTracker() {
    const data = window.__halyavkaPageData;
    if (!data) return;

    const { pageTitle, pageUrl } = data;
    const normalized = pageUrl.endsWith('/') ? pageUrl : pageUrl + '/';

    // При заходе на страницу — записываем посещение
    // (с hash-номером если он есть, или просто книгу если нет)
    function record() {
      const hash = window.location.hash.replace('#', '');
      const exercise = hash && /^\d+$/.test(hash) ? parseInt(hash, 10) : undefined;
      trackView({ url: normalized, title: pageTitle, exercise });
    }

    record();

    // При переключении номера в галерее — записываем новую запись
    window.addEventListener('hashchange', record);
  }

  document.addEventListener('astro:page-load', setupTracker);
  if (document.readyState !== 'loading') {
    setupTracker();
  }
</script>

<div class="max-w-4xl mx-auto px-4">
      <FacebookComments />
</div>
</PageLayout>