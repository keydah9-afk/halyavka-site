---
import PageLayout from '../layouts/PageLayout.astro';
import { Image } from 'astro:assets'; // Импортируем Image компонент
import FacebookComments from '~/components/FacebookComments.astro';
import halyavkaImage from '../assets/images/halyavka.webp';
import RecentlyViewed from '../components/RecentlyViewed.astro';

// Мета-данные для страницы, передаваемые в SeoComponent
const pageSeoProps = {
  title: 'ГДЗ Халявка — Готові домашні завдання з 1 по 11 клас онлайн',
  description: '✅ Найбільша база ГДЗ в Україні! На сайті ГДЗ Халявка ви знайдете готові відповіді до підручників з математики, української мови та інших предметів з 1 по 11 клас. Заходьте!',
  canonical: String(Astro.url.href), // Канонический URL для текущей страницы
  openGraph: {
    images: [{ url: halyavkaImage }], // Используем импортированный объект изображения
    type: 'website',
    locale: 'uk_UA',
  },
  twitter: {
    card: 'summary_large_image',
  },
};

const classes = [2, 3, 4, 5, 6, 7, 8, 9, 10]; // Добавьте все классы, которые у вас есть

// «Популярні ГДЗ» — прямые ссылки с главной на хабы книг. На главную ведёт
// большинство внешних ссылок сайта, а на хабы с неё до сих пор не вело ни одной.
// Отбор (27.09.2026): спрос на саму книгу — сумма частотности запросов, где названы
// автор и класс («гдз алгебра 8 клас істер»), по всей нише, Semrush 2026
// (~/Developer/semrush/НАЙДЕНО-сайт-halyavka-2709.md). Взяты книги от ~60 тыс.
// в месяц; порядок — по классу, внутри класса — по спросу.
// Не включены: учебники-2017 для 9 класса (алгебра Мерзляк, фізика Баряхтар) —
// с 2026/27 девятый класс учится по учебникам НУШ.
// Хабов пилота здесь нет НАМЕРЕННО: их не трогать до решения
// (см. CLAUDE.md, раздел «Пилот по ссылкам»). После решения — добавить сюда.
const popularBooks = [
  { title: 'Математика 2 клас — Листопад', href: '/2-klas/gdz-matematyka-lystopad/' },
  { title: 'Математика 4 клас — Листопад, 1 частина', href: '/4-klas/gdz-matematyka-lystopad-ch1/' },
  { title: 'Математика 4 клас — Листопад, 2 частина', href: '/4-klas/gdz-matematyka-lystopad-ch2/' },
  { title: 'Математика 5 клас — Мерзляк', href: '/5-klas/gdz-matematyka-merzlyak/' },
  { title: 'Українська мова 5 клас — Глазова', href: '/5-klas/gdz-ukr-mova-glazova/' },
  { title: 'Українська мова 5 клас — Заболотний', href: '/5-klas/gdz-ukr-mova-zabolotnyi/' },
  { title: 'Українська мова 6 клас — Заболотний', href: '/6-klas/gdz-ukr-mova-zabolotnyi/' },
  { title: 'Математика 6 клас — Мерзляк', href: '/6-klas/gdz-matematyka-merzlyak/' },
  { title: 'Українська мова 6 клас — Авраменко', href: '/6-klas/gdz-ukr-mova-avramenko/' },
  { title: 'Англійська мова 7 клас — Карпюк', href: '/7-klas/gdz-english-karpuk/' },
  { title: 'Алгебра 7 клас — Мерзляк', href: '/7-klas/gdz-algebra-merzlyak/' },
  { title: 'Українська мова 7 клас — Авраменко', href: '/7-klas/gdz-ukr-mova-avramenko/' },
  { title: 'Алгебра 8 клас — Істер', href: '/8-klas/gdz-algebra-ister/' },
  { title: 'Українська мова 8 клас — Заболотний', href: '/8-klas/gdz-ukr-mova-zabolotnyi/' },
  { title: 'Англійська мова 8 клас — Карпюк', href: '/8-klas/gdz-english-karpuk/' },
  { title: 'Геометрія 8 клас — Істер', href: '/8-klas/gdz-geometry-ister/' },
  { title: 'Алгебра 8 клас — Мерзляк', href: '/8-klas/gdz-algebra-merzlyak/' },
  { title: 'Геометрія 8 клас — Мерзляк', href: '/8-klas/gdz-geometry-merzlyak/' },
  { title: 'Українська мова 8 клас — Авраменко', href: '/8-klas/gdz-ukr-mova-avramenko/' },
  { title: 'Хімія 8 клас — Григорович', href: '/8-klas/gdz-himiya-grygorovych/' },
  { title: 'Геометрія 9 клас — Мерзляк', href: '/9-klas/gdz-geometry-merzlyak/' },
  { title: 'Геометрія 9 клас — Істер', href: '/9-klas/gdz-geometry-ister/' },
  { title: 'Алгебра 9 клас — Істер', href: '/9-klas/gdz-algebra-ister/' },
  { title: 'Українська мова 9 клас — Заболотний', href: '/9-klas/gdz-ukr-mova-zabolotnyi/' },
  { title: 'Українська мова 9 клас — Авраменко', href: '/9-klas/gdz-ukr-mova-avramenko/' },
  { title: 'Українська мова 10 клас — Авраменко', href: '/10-klas/gdz-ukr-mova-avramenko/' },
];
---

{/* Мета-теги генерирует Metadata внутри Layout — передаём pageSeoProps через metadata */}
<PageLayout metadata={pageSeoProps}>
  {/* JSON-LD микроразметка для главной страницы */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "http://schema.org",
    "@graph": [
      {
        "@type": "WebSite", // Тип для главной страницы
        "name": pageSeoProps.title,
        "description": pageSeoProps.description,
        "url": pageSeoProps.canonical,
        "image": halyavkaImage.src // Используем .src для получения URL изображения
      },
      {
        "@type": "CollectionPage", // Можно также добавить CollectionPage, если это список классов
        "name": pageSeoProps.title,
        "description": pageSeoProps.description,
        "url": pageSeoProps.canonical,
        "mainEntity": {
          "@type": "ItemList",
          "itemListElement": classes.map((c, index) => ({
            "@type": "ListItem",
            "position": index + 1,
            "item": {
              "@type": "WebPage", // Или CreativeWork, если это страницы отдельных классов
              "name": `${c} клас ГДЗ`,
              "url": `${Astro.url.origin}/${c}-klas/`
            }
          }))
        },
        "image": halyavkaImage.src
      }
    ]
  })} />

  <main itemprop="mainContentOfPage" class="px-4 text-center">

    {/* H1 уже использует Tailwind классы, но убедитесь, что они поддерживают dark: */}
    <h1 itemprop="headline" class="text-3xl font-bold text-center my-8 text-gray-900 dark:text-gray-50">
      ГДЗ Халявка — відповіді до шкільних підручників
    </h1>

    {/* ИСПОЛЬЗУЕМ КОМПОНЕНТ <Image> ДЛЯ ОПТИМИЗАЦИИ ГЛАВНОГО ИЗОБРАЖЕНИЯ */}
    <Image
      src={halyavkaImage}
      alt="Головна обкладинка Халявка — ГДЗ, готові домашні завдання онлайн"
      widths={[300, 700, 1000]}
      sizes="(max-width: 768px) 100vw, 700px"
      loading="eager"
      fetchpriority="high"
      class="mx-auto rounded-2xl shadow-xl max-w-full"
    />

    {/* P уже использует dark:text-gray-300 - отлично! */}
    <p class="max-w-3xl mx-auto mb-10 text-lg text-gray-700 dark:text-gray-300">
      Ласкаво просимо! Ми створили цей сайт, щоб допомогти учням та їхнім батькам
      швидко перевіряти домашні завдання та краще розуміти шкільну програму.
      Просто оберіть свій клас нижче, щоб почати.
    </p>

    <section itemscope itemtype="https://schema.org/ItemList" itemprop="hasPart" class="py-6">
      <meta itemprop="numberOfItems" content={classes.length} />
      {/* H2 - добавим dark: классы */}
      <h2 class="text-2xl font-semibold mb-6 text-gray-900 dark:text-gray-50">Оберіть клас</h2>
      <ul class="grid gap-4 grid-cols-2 sm:grid-cols-4 lg:grid-cols-4 max-w-6xl mx-auto list-none p-0">
        {classes.map((c, i) => (
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="m-0">
            <meta itemprop="position" content={i + 1} />
            <a
              itemprop="url"
              href={`/${c}-klas/`}
              class="
                flex h-12 w-full items-center justify-center
                rounded-xl border border-gray-300 dark:border-gray-600
                bg-white/60 dark:bg-gray-800/60
                font-semibold text-xl transition
                text-gray-900 dark:text-gray-100
                hover:bg-[#C1121F] hover:border-[#C1121F] hover:text-white
                dark:hover:bg-[#C1121F] dark:hover:border-[#C1121F] dark:hover:text-white
                active:bg-[#9E0E19] active:border-[#9E0E19] active:text-white
                dark:active:bg-[#9E0E19] dark:active:border-[#9E0E19]
              "
            >
              <span itemprop="name">{c}&nbsp;клас</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="popular-gdz" class="py-6 max-w-6xl mx-auto">
      <h2 id="popular-gdz" class="text-2xl font-semibold mb-6 text-gray-900 dark:text-gray-50">Популярні ГДЗ</h2>
      <ul class="grid gap-3 grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 list-none p-0">
        {popularBooks.map((book) => (
          <li class="m-0">
            <a
              href={book.href}
              class="
                flex h-full min-h-12 items-center justify-center
                rounded-xl border border-gray-300 dark:border-gray-600
                bg-white/60 dark:bg-gray-800/60
                px-3 py-2 text-sm sm:text-base font-medium leading-snug
                text-gray-900 dark:text-gray-100 transition
                hover:bg-[#C1121F] hover:border-[#C1121F] hover:text-white
                dark:hover:bg-[#C1121F] dark:hover:border-[#C1121F] dark:hover:text-white
                active:bg-[#9E0E19] active:border-[#9E0E19] active:text-white
                dark:active:bg-[#9E0E19] dark:active:border-[#9E0E19]
              "
            >
              {book.title}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="max-w-4xl mx-auto mt-12 py-8 text-left border-t border-gray-200 dark:border-gray-700">
      {/* H2 - добавим dark: классы */}
      <h2 class="text-2xl font-bold mb-4 text-center text-gray-900 dark:text-gray-50">Чим корисні готові домашні завдання?</h2>
      {/* Prose уже поддерживает dark:prose-invert - отлично! */}
      <div class="prose dark:prose-invert max-w-none text-lg">
        <p>
          Готові домашні завдання (ГДЗ) — це не просто шпаргалки, а незамінний інструмент
          для самоперевірки та поглиблення знань. Вони допомагають учням переконатися у
          правильності власних рішень, а батькам — легко проконтролювати виконання
          домашньої роботи.
        </p>
        <p>
          На нашому сайті "ГДЗ Халявка" зібрані відповіді до найактуальніших підручників
          шкільної програми України на 2025-2026 навчальний рік. Ми охоплюємо ключові
          предмети: математику, алгебру, геометрію, українську та англійську мови,
          фізику, хімію та багато інших.
        </p>
        <p>
          Користуватися сайтом дуже просто: оберіть ваш клас, знайдіть потрібний предмет
          і підручник, і ви миттєво отримаєте доступ до розв'язання усіх вправ та завдань.
        </p>
      </div>
    </section>


<RecentlyViewed />

<div class="max-w-4xl mx-auto px-4">
      <FacebookComments />
  </div>
  </main>
</PageLayout>