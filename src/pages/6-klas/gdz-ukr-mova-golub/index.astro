---

{/* Компонент PageLayout включает <head> и <body>, а также общие стили */}
<PageLayout metadata={pageSeoProps}>



  <BookSchema
    title={title}
    author={author}
    year={year}
    description={description}
    coverImage={coverImage}
    pageTitle={pageSeoProps.title}
    pageDescription={pageSeoProps.description}
  />
  <main itemprop="mainContentOfPage" class="text-center">

    <BookCover
      title={title}
      author={author}
      year={year}
      img={coverImage} // Передаем ИМПОРТИРОВАННЫЙ ОБЪЕКТ coverImage
      alt={`${title} обкладинка`} // Альтернативный текст для изображения
      description={description}
      typegdz={typegdz}
    />
    
    <ImageGallery
      id="gallery2"
      base={galleryBasePath} // Используем переменную для базового пути
      list={images}
    />
    </main>

<div class="flex justify-center my-4">
  <a
    href="/6-klas/"
    class="
      inline-flex items-center justify-center
      h-[40px] min-w-[42px] px-4
      rounded-[7px] border-4 border-[#C1121F]
      bg-[#033049]
      font-semibold text-[21px] text-white
      transition duration-150 ease-in-out
      hover:-translate-y-1 hover:shadow-lg
      shadow-none
      hover:bg-[#204060]
      active:bg-[#045]
    "
  >
    <span>Усі гдз для 6 класу</span>
  </a>
</div>
<RatingShare classTitle={title} />



<RecentlyViewed />
  <GdzTracker pageTitle={title} />

<div class="max-w-4xl mx-auto px-4">
      <FacebookComments />
</div>

</PageLayout>